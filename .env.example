# Sentinel Backend Environment Configuration
# Copy this file to .env for local overrides: cp .env.example .env

# Runtime environment (development | testing | production)
SENTINEL_ENV=development

# Logging level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Target Adapter Configuration
# URL of the AI application to evaluate (defaults to reference-target on port 8001)
SENTINEL_TARGET_URL=http://localhost:8001

# Total request timeout in seconds (connect + read)
TARGET_TIMEOUT_SECONDS=30.0

# Initial connection establishment timeout in seconds
TARGET_CONNECT_TIMEOUT_SECONDS=5.0

# Runner Orchestration Configuration
# Maximum concurrent attack dispatches (1 = deterministic sequential execution)
RUNNER_MAX_CONCURRENCY=1

# Target state reset policy: 'per_run' (reset once before suite), 'per_attack' (reset before every attack), 'never'
RUNNER_RESET_POLICY=per_run

# Future integration placeholders (do not commit actual secrets)
# SUPABASE_URL=
# SUPABASE_KEY=
# OPENAI_API_KEY=
