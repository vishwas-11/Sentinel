# Sentinel Backend Environment Configuration
# Copy this file to .env for local overrides: cp .env.example .env

# Runtime environment (development | testing | production)
SENTINEL_ENV=development

# Logging level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Target Adapter Configuration
# URL of the AI application to evaluate (defaults to reference-target on port 8001)
SENTINEL_TARGET_URL=http://localhost:8001

# Total request timeout in seconds (connect + read)
TARGET_TIMEOUT_SECONDS=30.0

# Initial connection establishment timeout in seconds
TARGET_CONNECT_TIMEOUT_SECONDS=5.0

# Runner Orchestration Configuration
# Maximum concurrent attack dispatches (1 = deterministic sequential execution)
RUNNER_MAX_CONCURRENCY=1

# Runner state reset policy: 'per_run' (reset once before suite), 'per_attack' (reset before every attack), 'never'
RUNNER_RESET_POLICY=per_run

# LLM Judge & Provider Configuration
# Provider selection: 'mock' (default, offline, zero-cost), 'openai', 'gemini'
LLM_PROVIDER=mock

# Model identifier for the semantic judge (e.g. gpt-4o-mini, gpt-4o, gemini-1.5-pro)
LLM_MODEL=gpt-4o-mini

# API key for the chosen LLM provider (optional when LLM_PROVIDER=mock)
# NEVER commit actual API keys to version control!
LLM_API_KEY=

# Maximum duration in seconds to wait for an LLM judge generation call
LLM_TIMEOUT_SECONDS=30.0

# Number of retry attempts on transient network or rate-limit failures (0 = disabled)
LLM_MAX_RETRIES=2

# Future integration placeholders (do not commit actual secrets)
# SUPABASE_URL=
# SUPABASE_KEY=
